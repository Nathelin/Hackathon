# Guardar como config.env (no se versiona). Mismo secreto para API y bridge.
HYDRO_API_TOKEN=reemplazar-con-un-secreto-de-al-menos-24-caracteres
HYDRO_API_URL=http://127.0.0.1:8080
HYDRO_PORT=8080
HYDRO_SERIAL=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
# Correo opcional: sin estos valores, sólo avisos en web/navegador.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=alertas@example.com
# SMTP_USER=usuario
# SMTP_PASSWORD=secreto
# ALERT_EMAIL_TO=destinatario@example.com

# El analizador conversacional funciona localmente y no necesita claves externas.
